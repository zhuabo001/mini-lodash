## \uc0\u55356 \u57263  \u27599 \u20010 \u20989 \u25968 \u30340  TS \u23454 \u29616 \u27169 \u26495 \
\
\uc0\u24314 \u35758 \u20320 \u25353 \u36825 \u20010 \u32467 \u26500 \u20889 \u65292 \u24378 \u36843 \u33258 \u24049 \u20570 \u31867 \u22411 \u23433 \u20840 \u65306 \
\
```typescript\
// src/array/chunk.ts\
/**\
 * \uc0\u23558 \u25968 \u32452 \u25353  size \u20999 \u20998 \u25104 \u22810 \u20010 \u22359 \
 * @param array \uc0\u28304 \u25968 \u32452 \
 * @param size \uc0\u27599 \u22359 \u22823 \u23567 \u65292 \u40664 \u35748  1\
 * @returns \uc0\u20108 \u32500 \u25968 \u32452 \
 */\
export function chunk<T>(array: T[] | null | undefined, size: number = 1): T[][] \{\
  if (!array || array.length === 0) return [];\
  \
  size = Math.max(Math.floor(size), 0);\
  if (size <= 0) return [];\
  \
  const result: T[][] = [];\
  for (let i = 0; i < array.length; i += size) \{\
    result.push(array.slice(i, i + size));\
  \}\
  return result;\
\}\
\
// \uc0\u36827 \u38454 \u65306 \u25903 \u25345  iteratee \u30340 \u27867 \u22411 \u35774 \u35745 \
type Iteratee<T, R> = ((value: T) => R) | keyof T | [keyof T, any] | Partial<T>;\
\
export function uniqBy<T, R>(array: T[], iteratee: Iteratee<T, R>): T[] \{\
  // \uc0\u23454 \u29616 ...\
\}\
```\
